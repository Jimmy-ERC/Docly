# ---------- Tests & coverage ----------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# ---------- Secrets & local config ----------
# Real credentials live in dotnet user-secrets (outside the repo).
# These cover any local fallback files, just in case.
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json

# ---------- Claude Code (private team context, never committed) ----------
CLAUDE.md
CLAUDE.local.md
.claude/

# ---------- Local file uploads (development only) ----------
# Documents are stored in Supabase Storage; ignore any local test uploads.
src/Docly.Web/wwwroot/uploads/

# ---------- OS files ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- Misc ----------
*.log
*.tmp
*.bak
*.swp
~$*