@model Docly.Web.ViewModels.Documents.DocumentUploadViewModel
@{
    ViewData["Title"] = "Subir documento";
}

<h1 class="h3 mb-3">Subir documento</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" autofocus />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">-- Selecciona --</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="File" class="form-label"></label>
        <input asp-for="File" type="file" class="form-control" accept=".pdf,.docx,.txt,.md" />
        <span asp-validation-for="File" class="text-danger"></span>
        <div class="form-text">PDF, Word (.docx), texto plano o Markdown. Máximo 20 MB.</div>
        <div class="alert alert-info mt-2 mb-0 py-2" role="note">
            <strong>Recomendación:</strong> para que la IA responda mejor, prefiere archivos de solo texto
            (.txt, .md o PDF/Word con texto seleccionable). Los archivos con muchas imágenes, tablas
            complejas o PDF escaneados pueden perder información al extraer el contenido.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Subir</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
