@using Docly.Domain.Documents
@model Docly.Web.ViewModels.Documents.DocumentEditViewModel
@{
    ViewData["Title"] = "Editar documento";

    var (badgeClass, badgeText) = Model.Processing?.Status switch
    {
        DocumentProcessingStatus.Completed => ("badge-soft-success with-dot", "Procesado"),
        DocumentProcessingStatus.Failed => ("badge-soft-danger with-dot", "Error al procesar"),
        DocumentProcessingStatus.ExtractingText => ("badge-soft-info with-dot is-working", "Extrayendo texto…"),
        DocumentProcessingStatus.Chunking => ("badge-soft-info with-dot is-working", "Fragmentando…"),
        DocumentProcessingStatus.Embedding => ("badge-soft-info with-dot is-working", "Generando embeddings…"),
        _ => ("badge-soft-muted with-dot", "Pendiente"),
    };
}

<h1 class="h3 mb-3">Editar documento <span class="text-muted">@Model.Title</span></h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" autofocus />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select">
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

<hr class="my-4" />

<h2 class="h5">Archivo actual</h2>
<p>
    <a asp-action="Download" asp-route-id="@Model.Id">@Model.FileName</a>
    <span class="text-muted">— @((Model.SizeBytes / 1024.0).ToString("N0")) KB, subido el @Model.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
</p>

<form asp-action="ReplaceFile" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="col-auto">
        <label class="form-label">Reemplazar archivo</label>
        <input type="file" name="File" class="form-control" accept=".pdf,.docx,.txt,.md" required />
        <div class="form-text">Recomendado: archivos de solo texto (.txt, .md) para que la IA funcione mejor.</div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Reemplazar</button>
    </div>
</form>

<hr class="my-4" />

<h2 class="h5">Procesamiento (base de conocimiento)</h2>
<p>
    <span class="badge badge-soft @badgeClass">@badgeText</span>
    @if (Model.Processing is { Status: DocumentProcessingStatus.Completed })
    {
        <span class="text-muted">— @Model.Processing.ChunkCount fragmento(s) con embedding, @Model.Processing.CompletedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        <a asp-controller="KnowledgeBase" asp-action="Chunks" asp-route-id="@Model.Id">Ver fragmentos</a>
    }
</p>
@if (Model.Processing is { Status: DocumentProcessingStatus.Failed })
{
    <p class="text-danger">@Model.Processing.ErrorMessage</p>
}
<form asp-action="Reprocess" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-outline-secondary">Reprocesar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
