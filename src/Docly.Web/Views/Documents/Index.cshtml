@model Docly.Web.ViewModels.Documents.DocumentIndexViewModel
@{
    ViewData["Title"] = "Documentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Documentos</h1>
    @if (User.HasPermission(PermissionCodes.DocumentsUpload))
    {
        <a asp-action="Create" class="btn btn-primary">Subir documento</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Buscar por título" />
    </div>
    <div class="col-sm-6 col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId is not null)
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Categoría</th>
                <th>Propietario</th>
                <th>Archivo</th>
                <th>Actualizado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var document in Model.Documents.Items)
        {
            <tr>
                <td><strong>@document.Title</strong></td>
                <td>@document.CategoryName</td>
                <td>@document.OwnerFullName</td>
                <td>
                    <a asp-action="Download" asp-route-id="@document.Id">@document.FileName</a>
                    <div class="text-muted small">@((document.SizeBytes / 1024.0).ToString("N0")) KB</div>
                </td>
                <td>@document.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end">
                    @if (User.HasPermission(PermissionCodes.DocumentsEdit))
                    {
                        <a asp-action="Edit" asp-route-id="@document.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    }
                    @if (User.HasPermission(PermissionCodes.DocumentsDelete))
                    {
                        <form asp-action="Delete" asp-route-id="@document.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar el documento @document.Title?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Documents.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron documentos.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Documents.TotalPages > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination">
            <li class="page-item @(Model.Documents.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Documents.Page - 1)">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Documents.Page / @Model.Documents.TotalPages</span></li>
            <li class="page-item @(Model.Documents.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-page="@(Model.Documents.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
