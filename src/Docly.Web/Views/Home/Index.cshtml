@{
    ViewData["Title"] = "Inicio";
}

<div class="hero text-center py-5 px-3">
    <h1 class="display-4 fw-bold">Docly</h1>
    <p class="lead">Gestión documental inteligente con búsqueda y chat sobre tus documentos.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Hola, <strong>@User.GetDisplayName()</strong>.</p>
    }
    else
    {
        <a class="btn btn-primary me-2" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Crear cuenta</a>
    }
</div>
