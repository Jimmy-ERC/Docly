@model Docly.Application.KnowledgeBase.DocumentChunksDto
@{
    ViewData["Title"] = "Fragmentos de " + Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Fragmentos <span class="text-muted">@Model.Title</span></h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<p class="text-muted">
    @Model.Chunks.TotalCount fragmento(s), @Model.EmbeddedChunkCount con embedding.
</p>

@foreach (var chunk in Model.Chunks.Items)
{
    <div class="card mb-2">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>#@chunk.ChunkIndex <span class="text-muted small">· @chunk.CharCount caracteres</span></span>
            @if (chunk.HasEmbedding)
            {
                <span class="badge bg-success">Con embedding</span>
            }
            else
            {
                <span class="badge bg-danger">Sin embedding</span>
            }
        </div>
        <div class="card-body">
            <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@chunk.Content</pre>
        </div>
    </div>
}

@if (Model.Chunks.TotalPages > 1)
{
    <nav aria-label="Paginación" class="mt-3">
        <ul class="pagination">
            <li class="page-item @(Model.Chunks.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Chunks" asp-route-id="@Model.DocumentId" asp-route-page="@(Model.Chunks.Page - 1)">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Chunks.Page / @Model.Chunks.TotalPages</span></li>
            <li class="page-item @(Model.Chunks.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Chunks" asp-route-id="@Model.DocumentId" asp-route-page="@(Model.Chunks.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
