@model Docly.Web.ViewModels.Notifications.NotificationIndexViewModel
@{
    ViewData["Title"] = "Notificaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notificaciones</h1>
    @if (Model.Notifications.Items.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Marcar todas como leídas</button>
        </form>
    }
</div>

<div class="list-group mb-3">
    @foreach (var notification in Model.Notifications.Items)
    {
        <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-light border-start border-3 border-primary")">
            <div class="d-flex w-100 justify-content-between">
                <h6 class="mb-1">@notification.Title</h6>
                <small class="text-muted">@notification.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <p class="mb-1">@notification.Message</p>
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(notification.Link))
                {
                    <a href="@notification.Link" class="btn btn-link btn-sm p-0">Ver</a>
                }
                @if (!notification.IsRead)
                {
                    <form asp-action="MarkAsRead" asp-route-id="@notification.Id" asp-route-returnUrl="@Context.Request.Path" method="post">
                        <button type="submit" class="btn btn-link btn-sm p-0">Marcar como leída</button>
                    </form>
                }
            </div>
        </div>
    }
    @if (Model.Notifications.Items.Count == 0)
    {
        <div class="list-group-item text-center text-muted py-4">No tienes notificaciones.</div>
    }
</div>

@if (Model.Notifications.TotalPages > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination">
            <li class="page-item @(Model.Notifications.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Notifications.Page - 1)">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Notifications.Page / @Model.Notifications.TotalPages</span></li>
            <li class="page-item @(Model.Notifications.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Notifications.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
