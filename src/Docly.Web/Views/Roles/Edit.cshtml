@model Docly.Web.ViewModels.Roles.RoleFormViewModel
@{
    ViewData["Title"] = "Editar rol";
}

<h1 class="h3 mb-3">Editar rol <span class="text-muted">@Model.Name</span></h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
