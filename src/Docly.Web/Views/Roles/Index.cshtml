@model Docly.Web.ViewModels.Roles.RoleIndexViewModel
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Roles y permisos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo rol</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Descripción</th>
                <th class="text-center">Permisos</th>
                <th class="text-center">Usuarios</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var role in Model.Roles)
        {
            <tr>
                <td>
                    <strong>@role.Name</strong>
                    @if (role.IsBuiltIn)
                    {
                        <span class="badge text-bg-info">Integrado</span>
                    }
                </td>
                <td>@role.Description</td>
                <td class="text-center">@role.PermissionCount</td>
                <td class="text-center">@role.UserCount</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    @if (!role.IsBuiltIn)
                    {
                        <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar el rol @role.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(role.UserCount > 0)"
                                    title="@(role.UserCount > 0 ? "Tiene usuarios asignados" : "Eliminar")">Eliminar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
