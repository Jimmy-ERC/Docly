@using Docly.Application.Search
@model Docly.Web.ViewModels.Search.SearchViewModel
@{
    ViewData["Title"] = "Búsqueda";
}

<h1 class="h3 mb-1">Búsqueda</h1>
<p class="text-muted">
    Combina similitud semántica y coincidencia de palabras clave para encontrar los fragmentos más relevantes,
    aunque no compartan exactamente las mismas palabras que tu pregunta.
</p>

<form method="get" class="row g-2 mb-4 filter-bar">
    <div class="col-md-6">
        <input type="search" name="q" value="@Model.Query" class="form-control" autofocus
               minlength="@IHybridSearchService.MinQueryLength" maxlength="@IHybridSearchService.MaxQueryLength"
               placeholder="Ej.: ¿cuál es el proceso para solicitar vacaciones?" />
    </div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (Model.Result is not null)
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (Model.Result is { } result)
{
    if (result.Hits.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron fragmentos relevantes para «@result.Query». Prueba con otras palabras o pide a un
            administrador que ajuste el umbral de similitud en Configuración.
        </div>
    }
    else
    {
        <p class="text-muted small">
            @result.Hits.Count @(result.Hits.Count == 1 ? "resultado" : "resultados")
            (máximo @result.TopK, similitud semántica mínima @result.SimilarityThreshold.ToString("P0")).
        </p>

        foreach (var hit in result.Hits)
        {
            <div class="card hit-card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h6 mb-1">@hit.DocumentTitle</h2>
                            <span class="badge badge-soft badge-soft-muted">@hit.CategoryName</span>
                            <span class="text-muted small ms-1">Fragmento @(hit.ChunkIndex + 1)</span>
                        </div>
                        <div class="text-end">
                            @if (hit.MatchedBySemanticSearch)
                            {
                                <span class="badge badge-soft badge-soft-info" title="Encontrado por similitud semántica">Semántica</span>
                            }
                            @if (hit.MatchedByKeywordSearch)
                            {
                                <span class="badge badge-soft badge-soft-success" title="Encontrado por coincidencia de palabras clave">Palabra clave</span>
                            }
                            @if (hit.Similarity is { } similarity)
                            {
                                <div class="mt-2" title="Similitud coseno"><span class="hit-score">@similarity.ToString("P0")</span></div>
                            }
                        </div>
                    </div>
                    <p class="hit-content mt-3 mb-3 text-break" style="white-space: pre-line;">@hit.Content</p>
                    <a asp-controller="Documents" asp-action="Download" asp-route-id="@hit.DocumentId"
                       class="btn btn-sm btn-outline-primary">Descargar documento</a>
                </div>
            </div>
        }
    }
}
