@using Docly.Application.Embeddings
@using Docly.Domain.Settings
@model Docly.Web.ViewModels.Settings.SystemSettingsViewModel
@{
    ViewData["Title"] = "Configuración del sistema";

    // Cards are rendered by index so the posted list keeps the same positions as Model.Settings.
    async Task RenderSetting(int i)
    {
        var setting = Model.Settings[i];
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <label class="form-label fw-bold" for="value-@i">@setting.Name</label>
                    <input type="hidden" asp-for="Settings[i].Key" />
                    <input type="hidden" asp-for="Settings[i].Name" />
                    <input type="hidden" asp-for="Settings[i].Description" />
                    <input type="hidden" asp-for="Settings[i].Type" />

                    @if (setting.Type == SystemSettingType.Text)
                    {
                        <input asp-for="Settings[i].Value" id="value-@i" class="form-control" />
                    }
                    else
                    {
                        <input asp-for="Settings[i].Value" id="value-@i" type="number"
                               step="@(setting.Type == SystemSettingType.Decimal ? "0.01" : "1")"
                               min="@setting.MinValue?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               max="@setting.MaxValue?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control" />
                    }

                    @if (!string.IsNullOrWhiteSpace(setting.Description))
                    {
                        <div class="form-text">@setting.Description</div>
                    }
                </div>
            </div>
        </div>
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Configuración del sistema</h1>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Index" method="post">
    <h2 class="h5">Pipeline RAG</h2>
    <div class="alert alert-secondary">
        <div>
            <strong>Modelo de embeddings:</strong> <code>@EmbeddingModelInfo.ModelName</code>
            · <strong>Dimensiones:</strong> @EmbeddingModelInfo.Dimensions
            <span class="text-muted">(fijos: cambiarlos haría que los vectores ya generados dejen de ser comparables con los nuevos)</span>
        </div>
        <div class="mt-1">
            Los cambios de tamaño y solapamiento de fragmentos solo se aplican a los documentos que se procesen
            a partir de ahora; usa <em>Reprocesar</em> en un documento para reindexarlo con los valores nuevos.
        </div>
    </div>

    <div class="row g-3 mb-4">
        @for (var i = 0; i < Model.Settings.Count; i++)
        {
            if (Model.Settings[i].IsRag)
            {
                await RenderSetting(i);
            }
        }
    </div>

    <h2 class="h5">Aplicación</h2>
    <div class="row g-3">
        @for (var i = 0; i < Model.Settings.Count; i++)
        {
            if (!Model.Settings[i].IsRag)
            {
                await RenderSetting(i);
            }
        }
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
</form>
