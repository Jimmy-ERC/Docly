@model Docly.Web.ViewComponents.NotificationBellViewModel

<li class="nav-item dropdown">
    <a class="nav-link position-relative" href="#" id="notificationBellDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        Notificaciones
        @if (Model.UnreadCount > 0)
        {
            <span class="badge rounded-pill bg-danger">@(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount.ToString())</span>
        }
    </a>
    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationBellDropdown" style="min-width: 320px;">
        @if (Model.Recent.Count == 0)
        {
            <li><span class="dropdown-item-text text-muted">No tienes notificaciones.</span></li>
        }
        else
        {
            @foreach (var notification in Model.Recent)
            {
                <li>
                    <a class="dropdown-item @(notification.IsRead ? "" : "fw-bold")" href="@(notification.Link ?? Url.Action("Index", "Notifications"))">
                        @notification.Title
                        <div class="small text-muted text-wrap">@notification.Message</div>
                    </a>
                </li>
            }
        }
        <li><hr class="dropdown-divider" /></li>
        <li><a class="dropdown-item text-center" asp-controller="Notifications" asp-action="Index">Ver todas</a></li>
    </ul>
</li>
