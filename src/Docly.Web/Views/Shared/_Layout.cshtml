@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Docly</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Docly.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Docly</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @NavClass("Home")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.HasPermission(PermissionCodes.UsersView))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Users")" asp-controller="Users" asp-action="Index">Usuarios</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.RolesManage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Roles")" asp-controller="Roles" asp-action="Index">Roles</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.DocumentsView))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Documents")" asp-controller="Documents" asp-action="Index">Documentos</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.DocumentsView))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("KnowledgeBase")" asp-controller="KnowledgeBase" asp-action="Index">Base de conocimiento</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Search")" asp-controller="Search" asp-action="Index">Búsqueda</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.ChatUse))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Chat")" asp-controller="Chat" asp-action="Index">Chat</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.CategoriesManage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Categories")" asp-controller="Categories" asp-action="Index">Categorías</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.SettingsManage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Settings")" asp-controller="Settings" asp-action="Index">Configuración</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.AuditView))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Audit")" asp-controller="Audit" asp-action="Index">Auditoría</a>
                            </li>
                        }
                        @if (User.HasPermission(PermissionCodes.StatsView))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavClass("Stats")" asp-controller="Stats" asp-action="Index">Estadísticas</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <vc:notification-bell />
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="navbar-text user-name">@User.GetDisplayName()</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            &copy; 2026 - Docly
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
