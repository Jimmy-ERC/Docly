@model Docly.Web.ViewModels.Users.UserIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Buscar por nombre o correo" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Roles</th>
                <th>Estado</th>
                <th>Registro</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users.Items)
        {
            <tr>
                <td>@user.FullName @(user.Id == Model.CurrentUserId ? "(tú)" : "")</td>
                <td>@user.Email</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge text-bg-secondary">@role</span>
                    }
                </td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">Desactivado</span>
                    }
                </td>
                <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                        @(User.HasPermission(PermissionCodes.UsersManage) ? "Gestionar" : "Ver")
                    </a>
                </td>
            </tr>
        }
        @if (Model.Users.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron usuarios.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Users.TotalPages > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination">
            <li class="page-item @(Model.Users.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Users.Page - 1)">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Users.Page / @Model.Users.TotalPages</span></li>
            <li class="page-item @(Model.Users.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Users.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
